---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;

const title       = frontmatter.title;
const description = frontmatter.description;
const pubDate     = frontmatter.pubDate;
const keywords    = frontmatter.keywords || '';
const author      = frontmatter.author || 'Buggy Sahara DXB';
const canonical   = `https://buggysaharadxb.com/blog/${frontmatter.slug || ''}`;

function readingTime(content: string) {
  const words = content?.split(/\s+/).length || 0;
  return Math.max(1, Math.round(words / 200));
}

const rawContent  = Astro.props.rawContent?.() || '';
const readMins    = readingTime(rawContent);

const dateObj     = pubDate ? new Date(pubDate) : new Date();
const dateDisplay = dateObj.toLocaleDateString('en-AE', { year: 'numeric', month: 'long', day: 'numeric' });
const dateISO     = dateObj.toISOString();
---
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{title} | Buggy Sahara DXB</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content={author} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/og-image.jpg" />
  <meta property="og:site_name" content="Buggy Sahara DXB" />
  <meta property="og:locale" content="en_AE" />
  <meta property="article:published_time" content={dateISO} />
  <meta property="article:author" content={author} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <meta name="geo.region" content="AE-DU" />
  <meta name="geo.placename" content="Dubai, United Arab Emirates" />

  <link rel="icon" type="image/svg+xml" href="/logo/Svg/SourceFiles-01.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800;900&family=Oswald:wght@200;300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" crossorigin="anonymous" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "author": { "@type": "Organization", "name": "Buggy Sahara DXB", "url": "https://buggysaharadxb.com" },
    "publisher": {
      "@type": "Organization",
      "name": "Buggy Sahara DXB",
      "logo": { "@type": "ImageObject", "url": "https://buggysaharadxb.com/logo/Png/SourceFiles-01.png" }
    },
    "datePublished": dateISO,
    "dateModified": dateISO,
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
    "image": "https://buggysaharadxb.com/og-image.jpg"
  })} />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@3.4.1/base.min.css" />

  <style>
    body { background: #0a0a0a; color: #e5e7eb; font-family: 'Inter', sans-serif; }
    .prose h1 { font-family: 'Bebas Neue', sans-serif; font-size: 2.6rem; line-height: 1.1; color: #fff; margin-bottom: 1rem; }
    .prose h2 { font-family: 'Oswald', sans-serif; font-size: 1.55rem; color: #facc15; margin: 2.2rem 0 0.9rem; font-weight: 600; }
    .prose h3 { font-family: 'Rajdhani', sans-serif; font-size: 1.2rem; color: #fff; margin: 1.5rem 0 0.5rem; font-weight: 700; }
    .prose p { line-height: 1.8; color: #d1d5db; margin-bottom: 1.1rem; }
    .prose ul { list-style: disc; padding-left: 1.5rem; color: #d1d5db; margin-bottom: 1rem; }
    .prose ul li { margin-bottom: 0.35rem; line-height: 1.7; }
    .prose ol { list-style: decimal; padding-left: 1.5rem; color: #d1d5db; margin-bottom: 1rem; }
    .prose ol li { margin-bottom: 0.35rem; line-height: 1.7; }
    .prose a { color: #facc15; text-decoration: underline; text-underline-offset: 2px; }
    .prose a:hover { color: #fde047; }
    .prose strong { color: #fff; font-weight: 600; }
    .prose hr { border-color: rgba(250,204,21,0.15); margin: 2rem 0; }
    .prose blockquote { border-left: 3px solid #facc15; padding-left: 1.2rem; color: #9ca3af; font-style: italic; margin: 1.5rem 0; }
    @media (max-width: 768px) {
      .prose h1 { font-size: 1.9rem; }
      .prose h2 { font-size: 1.3rem; }
    }
  </style>
</head>
<body>
  <Header />

  <!-- Hero bar -->
  <div style="background:linear-gradient(135deg,#1a1200 0%,#0a0a0a 100%);border-bottom:1px solid rgba(250,204,21,0.1);padding:2.5rem 0 0">
    <div style="max-width:900px;margin:0 auto;padding:0 1.5rem">
      <!-- Breadcrumb -->
      <nav style="font-size:0.78rem;color:#6b7280;margin-bottom:1.2rem">
        <a href="/" style="color:#6b7280;text-decoration:none">Home</a>
        <span style="margin:0 0.5rem">/</span>
        <a href="/blog" style="color:#6b7280;text-decoration:none">Blog</a>
        <span style="margin:0 0.5rem">/</span>
        <span style="color:#9ca3af">{title}</span>
      </nav>

      <h1 style="font-family:'Bebas Neue',sans-serif;font-size:2.8rem;line-height:1.1;color:#fff;margin:0 0 1rem">{title}</h1>

      <div style="display:flex;align-items:center;gap:1.2rem;flex-wrap:wrap;padding-bottom:1.5rem;border-bottom:1px solid rgba(250,204,21,0.1);margin-bottom:0">
        <span style="font-size:0.82rem;color:#6b7280;display:flex;align-items:center;gap:0.4rem">
          <i class="fas fa-calendar-alt" style="color:rgba(250,204,21,0.5)"></i> {dateDisplay}
        </span>
        <span style="font-size:0.82rem;color:#6b7280;display:flex;align-items:center;gap:0.4rem">
          <i class="fas fa-clock" style="color:rgba(250,204,21,0.5)"></i> {readMins} min read
        </span>
        <span style="font-size:0.82rem;color:#6b7280;display:flex;align-items:center;gap:0.4rem">
          <i class="fas fa-map-marker-alt" style="color:rgba(250,204,21,0.5)"></i> Dubai, UAE
        </span>
      </div>
    </div>
  </div>

  <main style="max-width:1100px;margin:0 auto;padding:2.5rem 1.5rem;display:grid;grid-template-columns:1fr 300px;gap:3rem;align-items:start">
    <!-- Article -->
    <article class="prose" style="min-width:0">
      <slot />
    </article>

    <!-- Sidebar -->
    <aside style="position:sticky;top:2rem">
      <!-- Book CTA -->
      <div style="background:linear-gradient(135deg,rgba(250,204,21,0.08),rgba(250,204,21,0.03));border:1px solid rgba(250,204,21,0.25);border-radius:1rem;padding:1.5rem;margin-bottom:1.5rem">
        <div style="font-family:'Bebas Neue',sans-serif;font-size:1.6rem;color:#facc15;margin-bottom:0.4rem">BOOK YOUR RIDE</div>
        <p style="font-size:0.85rem;color:#9ca3af;margin-bottom:1.2rem;line-height:1.6">From AED 150 / 30 min · Can-Am, Polaris & more · Self-drive or guided</p>
        <a href="/booking" style="display:block;background:#facc15;color:#000;text-align:center;padding:0.9rem;border-radius:0.75rem;font-family:'Oswald',sans-serif;font-size:1rem;font-weight:700;text-decoration:none;letter-spacing:0.05em">
          <i class="fas fa-flag-checkered" style="margin-right:0.4rem"></i> Book Now
        </a>
        <a href="https://wa.me/971505371693" target="_blank" rel="noopener" style="display:block;background:rgba(37,211,102,0.12);border:1px solid rgba(37,211,102,0.3);color:#25d366;text-align:center;padding:0.75rem;border-radius:0.75rem;font-family:'Oswald',sans-serif;font-size:0.9rem;font-weight:600;text-decoration:none;margin-top:0.6rem">
          <i class="fab fa-whatsapp" style="margin-right:0.4rem"></i> WhatsApp Us
        </a>
      </div>

      <!-- Fleet highlights -->
      <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);border-radius:1rem;padding:1.4rem;margin-bottom:1.5rem">
        <div style="font-family:'Oswald',sans-serif;font-size:0.75rem;color:#6b7280;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:1rem">Popular Buggies</div>
        {[
          { name: 'Can-Am R X RS 2025', price: 'AED 800 / 30 min', badge: 'VIP' },
          { name: 'Polaris RZR 1000XP', price: 'AED 400 / 30 min', badge: '4-Seat' },
          { name: 'CF Moto 1000cc 4x4', price: 'AED 249 / 30 min', badge: 'Value' },
        ].map(b => (
          <div style="display:flex;justify-content:space-between;align-items:center;padding:0.6rem 0;border-bottom:1px solid rgba(255,255,255,0.05)">
            <div>
              <div style="font-size:0.82rem;color:#e5e7eb;font-weight:500">{b.name}</div>
              <div style="font-size:0.72rem;color:#9ca3af">{b.price}</div>
            </div>
            <span style="font-size:0.65rem;font-weight:700;padding:0.2rem 0.5rem;background:rgba(250,204,21,0.12);color:#facc15;border-radius:9999px">{b.badge}</span>
          </div>
        ))}
        <a href="/booking" style="display:block;text-align:center;font-size:0.8rem;color:#facc15;text-decoration:none;margin-top:0.8rem;font-family:'Oswald',sans-serif;letter-spacing:0.05em">
          See Full Fleet →
        </a>
      </div>

      <!-- Recent posts -->
      <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);border-radius:1rem;padding:1.4rem">
        <div style="font-family:'Oswald',sans-serif;font-size:0.75rem;color:#6b7280;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:1rem">More Articles</div>
        {[
          { href: '/blog/dune-buggy-rental-dubai-prices-2025', title: 'Dune Buggy Rental Dubai: 2025 Prices' },
          { href: '/blog/dubai-dune-buggy-tours-what-to-expect', title: 'Dubai Dune Buggy Tours: What to Expect' },
          { href: '/blog/desert-buggy-dubai-experience', title: 'Desert Buggy Dubai: Full Guide' },
          { href: '/blog/quad-bike-vs-dune-buggy-dubai', title: 'Quad Bike vs Dune Buggy Dubai' },
        ].map(p => (
          <a href={p.href} style="display:block;font-size:0.82rem;color:#d1d5db;text-decoration:none;padding:0.45rem 0;border-bottom:1px solid rgba(255,255,255,0.04);line-height:1.4">
            → {p.title}
          </a>
        ))}
      </div>
    </aside>
  </main>

  <!-- Bottom CTA -->
  <div style="background:linear-gradient(135deg,rgba(250,204,21,0.06),rgba(0,0,0,0));border-top:1px solid rgba(250,204,21,0.12);padding:3rem 1.5rem;text-align:center">
    <div style="max-width:600px;margin:0 auto">
      <div style="font-family:'Bebas Neue',sans-serif;font-size:2.2rem;color:#fff;margin-bottom:0.5rem">READY TO HIT THE DUNES?</div>
      <p style="color:#9ca3af;margin-bottom:1.5rem;font-size:0.95rem">Book your dune buggy rental in Dubai today. Instant confirmation · Free rescheduling</p>
      <a href="/booking" style="display:inline-block;background:#facc15;color:#000;padding:1rem 2.5rem;border-radius:0.75rem;font-family:'Oswald',sans-serif;font-size:1.1rem;font-weight:700;text-decoration:none;letter-spacing:0.05em">
        Book Your Buggy Now →
      </a>
    </div>
  </div>

  <Footer />

  <style is:global>
    @media (max-width: 768px) {
      main { grid-template-columns: 1fr !important; }
      aside { position: static !important; }
    }
  </style>
</body>
</html>
