---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Booking Confirmed! | Buggy Sahara DXB"
  description="Your desert adventure booking is confirmed. Get ready to conquer the Dubai dunes with Buggy Sahara DXB!"
>
  <Header />
  <main class="min-h-screen bg-[#0D0D0D] flex items-center justify-center px-4 pt-24 pb-16">
    <div class="max-w-lg w-full text-center">

      <div class="glass border border-yellow-400/30 rounded-3xl p-10 md:p-14">

        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-yellow-400 to-yellow-600 flex items-center justify-center mx-auto mb-6 shadow-gold">
          <i class="fas fa-check text-black text-3xl"></i>
        </div>

        <h1 class="font-racing text-4xl md:text-5xl text-white mb-3">
          BOOKING <span class="text-gradient-gold">CONFIRMED!</span>
        </h1>

        <p class="text-gray-400 mb-2 text-lg" id="pkg-name"></p>
        <p class="text-gray-500 text-sm mb-8">
          A confirmation email has been sent. Our team will WhatsApp you within 30 minutes with your final details.
        </p>

        <div class="space-y-3 mb-8">
          <a
            href="https://wa.me/971505371693?text=Hi! I just paid for my desert adventure booking. Excited to ride!"
            target="_blank"
            rel="noopener"
            class="btn-gold w-full flex items-center justify-center gap-3 py-4 rounded-xl text-base shine"
          >
            <i class="fab fa-whatsapp text-xl"></i>
            <span class="font-display tracking-wide">Chat With Us on WhatsApp</span>
          </a>
          <a
            href="/"
            class="btn-outline w-full flex items-center justify-center gap-3 py-4 rounded-xl text-base"
          >
            <i class="fas fa-home"></i>
            <span class="font-display">Back to Home</span>
          </a>
        </div>

        <div class="flex flex-wrap justify-center gap-3 text-xs text-gray-600">
          <span class="flex items-center gap-1"><i class="fas fa-shield-alt text-yellow-400/50"></i> Secure Payment</span>
          <span class="flex items-center gap-1"><i class="fas fa-undo text-yellow-400/50"></i> Free Rescheduling</span>
          <span class="flex items-center gap-1"><i class="fas fa-headset text-yellow-400/50"></i> 24/7 Support</span>
        </div>
      </div>

    </div>
  </main>
  <Footer />
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const pkg = params.get('pkg');
  const el = document.getElementById('pkg-name');
  if (el && pkg) {
    el.textContent = decodeURIComponent(pkg);
  }
</script>
