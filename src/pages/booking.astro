const timeslots = [
  { id: "0600", label: "6:00 AM", sub: "Sunrise Safari", available: true },
  { id: "0800", label: "8:00 AM", sub: "Morning Dunes", available: true },
  { id: "1000", label: "10:00 AM", sub: "Peak Adventure", available: false },
  { id: "1200", label: "12:00 PM", sub: "Midday Blast", available: true },
  { id: "1400", label: "2:00 PM", sub: "Afternoon Ride", available: false },
  { id: "1600", label: "4:00 PM", sub: "Golden Hour", available: true },
  { id: "1800", label: "6:00 PM", sub: "Sunset Tour", available: true },
  { id: "2000", label: "8:00 PM", sub: "Night Desert", available: true },
];
---

<Layout
  title="Book Your Dune Buggy Dubai | Buggy Sahara DXB"
  description="Book your dune buggy experience in Dubai. Choose your buggy, pick a timeslot and pay securely online. Instant confirmation."
  keywords="book dune buggy Dubai, dune buggy booking, desert buggy reservation, buggy safari booking Dubai"
  url="https://buggysaharadxb.com/booking"
>
  <Header />

  <main class="bg-[#0D0D0D] min-h-screen pt-28 pb-20">

    <!-- Progress Bar -->
    <div class="sticky top-16 md:top-20 z-40 bg-[#0D0D0D]/95 backdrop-blur-xl border-b border-yellow-400/10 py-3 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-2 md:gap-4">
          {[
            { num: 1, label: "Choose Buggy" },
            { num: 2, label: "Pick Timeslot" },
            { num: 3, label: "Your Offer" },
            { num: 4, label: "Pay & Confirm" },
          ].map((s, i) => (
            <div class="flex items-center gap-2 md:gap-4 flex-1">
              <div class="flex items-center gap-1.5 md:gap-2 flex-shrink-0">
                <div
                  id={`step-circle-${s.num}`}
                  class={`w-7 h-7 md:w-8 md:h-8 rounded-full flex items-center justify-center text-xs md:text-sm font-bold transition-all duration-300 ${s.num === 1 ? 'bg-yellow-400 text-black' : 'bg-black/40 border border-yellow-400/20 text-gray-500'}`}
                >
                  {s.num}
                </div>
                <span id={`step-label-${s.num}`} class={`font-display text-xs md:text-sm hidden sm:block transition-colors duration-300 ${s.num === 1 ? 'text-yellow-400' : 'text-gray-600'}`}>
                  {s.label}
                </span>
              </div>
              {i < 3 && (
                <div class="flex-1 h-0.5 bg-yellow-400/10 rounded-full overflow-hidden">
                  <div id={`step-bar-${s.num}`} class="h-full bg-yellow-400 w-0 transition-all duration-500 rounded-full"></div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 py-8">

      <!-- ══════════════════════════════════════════════
           STEP 1 — Choose Your Buggy
      ══════════════════════════════════════════════ -->
      <div id="step-1" class="step-section">
        <div class="text-center mb-10">
          <span class="text-yellow-400/60 text-sm tracking-widest uppercase font-semibold">Step 1 of 4</span>
          <h1 class="font-racing text-4xl md:text-5xl text-white mt-2">CHOOSE YOUR <span class="text-gradient-gold">MACHINE</span></h1>
          <p class="text-gray-400 mt-3 text-lg">Select the buggy that matches your group size and thrill level</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5" id="buggy-grid">
          {buggies.map(buggy => (
            <div
              class="buggy-card relative border border-yellow-400/15 rounded-2xl overflow-hidden bg-[#161616] cursor-pointer hover:border-yellow-400/50 transition-all duration-300 group"
              data-buggy-id={buggy.id}
              data-buggy-name={buggy.name}
              data-buggy-price={buggy.price}
              data-buggy-seats={buggy.seats}
              data-buggy-color={buggy.color}
            >
              <!-- Selected check overlay -->
              <div class="selected-overlay absolute inset-0 z-20 hidden">
                <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-yellow-400 flex items-center justify-center shadow-lg shadow-yellow-400/40">
                  <i class="fas fa-check text-black text-sm"></i>
                </div>
                <div class="absolute inset-0 border-2 border-yellow-400 rounded-2xl pointer-events-none"></div>
              </div>

              <!-- Tag -->
              <div class="absolute top-3 left-3 z-10">
                <span class={`${buggy.tagColor} text-xs font-bold px-2.5 py-1 rounded-full shadow-md`}>{buggy.tag}</span>
              </div>

              <!-- Image -->
              <div class="relative h-44 bg-black/40 overflow-hidden">
                <img
                  src={buggy.image}
                  alt={`${buggy.name} dune buggy Dubai`}
                  class="w-full h-full object-cover opacity-75 group-hover:opacity-95 group-hover:scale-105 transition-all duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#161616] via-transparent to-transparent"></div>
              </div>

              <!-- Content -->
              <div class="p-5">
                <h3 class="font-display text-white text-base leading-tight mb-1">{buggy.name}</h3>
                <div class="flex items-center gap-3 mb-3 text-xs text-gray-500">
                  <span><i class="fas fa-users mr-1" style={`color:${buggy.color}`}></i>{buggy.seats}</span>
                  <span><i class="fas fa-tachometer-alt mr-1" style={`color:${buggy.color}`}></i>{buggy.engine}</span>
                  <span><i class="fas fa-bolt mr-1" style={`color:${buggy.color}`}></i>{buggy.power}</span>
                </div>
                <p class="text-gray-500 text-xs leading-relaxed mb-4">{buggy.description}</p>
                <div class="flex items-center justify-between">
                  <div>
                    <span class="font-racing text-2xl text-yellow-400">AED {buggy.price}</span>
                    <span class="text-gray-600 text-xs ml-1">/ 30 min</span>
                  </div>
                  <button class="select-buggy-btn btn-gold px-4 py-2 rounded-xl text-xs font-display shine">
                    Select
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ══════════════════════════════════════════════
           STEP 2 — Pick Timeslot
      ══════════════════════════════════════════════ -->
      <div id="step-2" class="step-section hidden">
        <div class="text-center mb-10">
          <span class="text-yellow-400/60 text-sm tracking-widest uppercase font-semibold">Step 2 of 4</span>
          <h2 class="font-racing text-4xl md:text-5xl text-white mt-2">PICK YOUR <span class="text-gradient-gold">TIMESLOT</span></h2>
          <p class="text-gray-400 mt-3 text-lg">Choose your date and preferred adventure time</p>
        </div>

        <!-- Selected buggy summary -->
        <div id="step2-buggy-summary" class="glass border border-yellow-400/20 rounded-2xl p-4 mb-8 flex items-center gap-4">
          <img id="step2-buggy-img" src="" alt="" class="w-16 h-16 rounded-xl object-cover" />
          <div class="flex-grow">
            <div id="step2-buggy-name" class="font-display text-white text-base"></div>
            <div id="step2-buggy-price" class="text-yellow-400 text-sm font-bold mt-0.5"></div>
          </div>
          <button onclick="goToStep(1)" class="text-gray-500 hover:text-yellow-400 text-xs underline transition-colors">Change</button>
        </div>

        <!-- Date picker -->
        <div class="mb-8">
          <label class="block text-gray-400 text-xs uppercase tracking-widest font-semibold mb-3">Select Date</label>
          <input
            type="date"
            id="booking-date"
            class="w-full max-w-xs bg-black/40 border border-yellow-400/20 rounded-xl px-5 py-3.5 text-white text-base focus:outline-none focus:border-yellow-400/60 transition-colors"
          />
        </div>

        <!-- Timeslots -->
        <div class="mb-10">
          <label class="block text-gray-400 text-xs uppercase tracking-widest font-semibold mb-4">Available Times</label>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {timeslots.map(slot => (
              <button
                class={`timeslot-btn relative rounded-xl p-4 text-center border transition-all duration-200 ${slot.available ? 'border-yellow-400/20 bg-black/30 hover:border-yellow-400/50 cursor-pointer' : 'border-gray-800 bg-black/10 cursor-not-allowed opacity-40'}`}
                data-slot-id={slot.id}
                data-slot-label={slot.label}
                disabled={!slot.available}
              >
                {!slot.available && (
                  <div class="absolute top-2 right-2 text-[9px] text-red-400/70 font-bold uppercase tracking-wide">Taken</div>
                )}
                <div class="font-racing text-xl text-white">{slot.label}</div>
                <div class="text-yellow-400/70 text-xs mt-1">{slot.sub}</div>
              </button>
            ))}
          </div>
        </div>

        <div class="flex gap-4">
          <button onclick="goToStep(1)" class="btn-outline px-6 py-3 rounded-xl font-display text-sm">
            <i class="fas fa-arrow-left mr-2"></i>Back
          </button>
          <button id="step2-next" onclick="goToStep(3)" class="btn-gold px-8 py-3 rounded-xl font-display text-base shine flex-grow" disabled>
            Continue to Your Offer <i class="fas fa-arrow-right ml-2"></i>
          </button>
        </div>
      </div>

      <!-- ══════════════════════════════════════════════
           STEP 3 — Hormozi Offer Stack
      ══════════════════════════════════════════════ -->
      <div id="step-3" class="step-section hidden">
        <div class="text-center mb-8">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/15 border border-red-500/30 text-red-400 text-sm font-bold mb-4 animate-pulse">
            <i class="fas fa-fire"></i> LIMITED AVAILABILITY — Only <span id="slots-left" class="text-white">3</span> slots left today
          </div>
          <h2 class="font-racing text-4xl md:text-5xl text-white">HERE'S EVERYTHING <span class="text-gradient-gold">YOU GET</span></h2>
          <p class="text-gray-400 mt-3 text-lg">Your complete desert adventure package — zero hidden fees</p>
        </div>

        <!-- Offer card -->
        <div class="max-w-2xl mx-auto">
          <div class="glass border border-yellow-400/25 rounded-3xl overflow-hidden shadow-2xl" style="box-shadow: 0 0 80px rgba(212,175,55,0.12)">
            <div class="h-1.5 bg-gradient-to-r from-yellow-600 via-yellow-400 to-yellow-600"></div>

            <div class="p-8">
              <!-- Main item -->
              <div class="flex items-start gap-4 p-5 bg-yellow-400/8 border border-yellow-400/20 rounded-2xl mb-6">
                <div class="w-12 h-12 rounded-2xl bg-yellow-400/20 flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-car text-yellow-400 text-xl"></i>
                </div>
                <div class="flex-grow">
                  <div class="text-yellow-400 text-xs font-bold uppercase tracking-widest mb-1">Your Selected Buggy</div>
                  <div id="offer-buggy-name" class="font-display text-white text-lg"></div>
                  <div id="offer-slot-summary" class="text-gray-400 text-sm mt-0.5"></div>
                </div>
                <div class="text-right flex-shrink-0">
                  <div id="offer-buggy-price" class="font-racing text-2xl text-yellow-400"></div>
                  <div class="text-gray-500 text-xs">AED / 30 min</div>
                </div>
              </div>

              <!-- Bonus stack -->
              <div class="text-gray-400 text-xs uppercase tracking-widest font-bold mb-4">Included Free — Today Only</div>
              <div class="space-y-3 mb-8">
                {[
                  { icon: "fas fa-hard-hat", title: "Full Safety Gear Set", sub: "Helmet, goggles, gloves, neck brace", value: "AED 200" },
                  { icon: "fas fa-user-shield", title: "Certified Desert Guide", sub: "Expert instructor with you the entire ride", value: "AED 300" },
                  { icon: "fas fa-chalkboard-teacher", title: "Professional Safety Briefing", sub: "Full pre-ride orientation and route brief", value: "AED 150" },
                  { icon: "fas fa-camera", title: "GoPro Mount + Download", sub: "Record your entire adventure in 4K", value: "AED 250" },
                  { icon: "fas fa-camera-retro", title: "Desert Photography Session", sub: "Action photos delivered within 24 hours", value: "AED 400" },
                ].map(bonus => (
                  <div class="flex items-center gap-4 p-4 bg-black/30 border border-yellow-400/10 rounded-xl">
                    <div class="w-9 h-9 rounded-xl bg-green-400/15 flex items-center justify-center flex-shrink-0">
                      <i class={`${bonus.icon} text-green-400 text-sm`}></i>
                    </div>
                    <div class="flex-grow">
                      <div class="text-white text-sm font-semibold">{bonus.title}</div>
                      <div class="text-gray-500 text-xs">{bonus.sub}</div>
                    </div>
                    <div class="text-right flex-shrink-0">
                      <div class="text-gray-500 text-xs line-through">{bonus.value}</div>
                      <div class="text-green-400 text-xs font-bold">FREE</div>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Total value -->
              <div class="border-t border-yellow-400/15 pt-6 mb-6">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-gray-400 text-sm">Total bundle value</span>
                  <span id="offer-total-value" class="text-gray-400 line-through text-base"></span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="font-display text-white text-lg">Your price today</span>
                  <div class="text-right">
                    <span id="offer-final-price" class="font-racing text-4xl text-yellow-400"></span>
                    <span class="text-gray-500 text-sm ml-1">AED</span>
                  </div>
                </div>
              </div>

              <!-- Guarantee -->
              <div class="flex items-start gap-3 p-4 bg-green-400/8 border border-green-400/20 rounded-2xl mb-8">
                <div class="w-10 h-10 rounded-full bg-green-400/15 flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-shield-alt text-green-400"></i>
                </div>
                <div>
                  <div class="font-display text-white text-sm mb-1">100% Satisfaction Guarantee</div>
                  <div class="text-gray-400 text-xs leading-relaxed">If you're not completely thrilled within the first 5 minutes of your ride, we'll reschedule you at zero cost — no questions asked.</div>
                </div>
              </div>

              <!-- Scarcity + CTA -->
              <div class="text-center mb-4">
                <div class="text-red-400 text-xs font-bold uppercase tracking-widest mb-4">
                  <i class="fas fa-clock mr-1"></i> Slots are filling fast — secure yours now
                </div>
                <button
                  onclick="goToStep(4)"
                  class="btn-gold w-full py-5 rounded-2xl text-lg font-display shine flex items-center justify-center gap-3 group"
                >
                  <i class="fas fa-lock text-base"></i>
                  <span>YES! Book My Adventure Now</span>
                  <i class="fas fa-arrow-right text-base group-hover:translate-x-1 transition-transform"></i>
                </button>
                <p class="text-gray-600 text-xs mt-3 flex items-center justify-center gap-2">
                  <i class="fab fa-stripe text-purple-400"></i> Secured by Stripe · 256-bit SSL · Instant confirmation
                </p>
              </div>
            </div>
          </div>

          <div class="mt-5 text-center">
            <button onclick="goToStep(2)" class="text-gray-600 hover:text-gray-400 text-sm underline transition-colors">
              <i class="fas fa-arrow-left mr-1"></i> Change timeslot
            </button>
          </div>
        </div>
      </div>

      <!-- ══════════════════════════════════════════════
           STEP 4 — Pay & Confirm
      ══════════════════════════════════════════════ -->
      <div id="step-4" class="step-section hidden">
        <div class="text-center mb-10">
          <span class="text-yellow-400/60 text-sm tracking-widest uppercase font-semibold">Step 4 of 4</span>
          <h2 class="font-racing text-4xl md:text-5xl text-white mt-2">CONFIRM & <span class="text-gradient-gold">PAY</span></h2>
          <p class="text-gray-400 mt-3">Almost there — enter your details to lock in your adventure</p>
        </div>

        <div class="max-w-2xl mx-auto">

          <!-- Booking summary card -->
          <div id="step4-summary" class="glass border border-yellow-400/20 rounded-2xl p-5 mb-8">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-display text-white text-base">Your Booking Summary</h3>
              <button onclick="goToStep(1)" class="text-gray-500 hover:text-yellow-400 text-xs underline transition-colors">Edit</button>
            </div>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-gray-400">Buggy</span><span id="s4-buggy" class="text-white font-semibold"></span></div>
              <div class="flex justify-between"><span class="text-gray-400">Date</span><span id="s4-date" class="text-white font-semibold"></span></div>
              <div class="flex justify-between"><span class="text-gray-400">Time</span><span id="s4-time" class="text-white font-semibold"></span></div>
              <div class="flex justify-between border-t border-yellow-400/10 pt-2 mt-2">
                <span class="text-gray-400">Total</span>
                <span id="s4-price" class="text-yellow-400 font-racing text-xl"></span>
              </div>
            </div>
          </div>

          <!-- Payment form -->
          <form id="payment-form" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-gray-400 text-xs uppercase tracking-widest font-semibold mb-2">Your Name *</label>
                <input type="text" id="pay-name" required placeholder="Full name"
                  class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white placeholder-gray-600 text-sm focus:outline-none focus:border-yellow-400/60 transition-colors" />
              </div>
              <div>
                <label class="block text-gray-400 text-xs uppercase tracking-widest font-semibold mb-2">Email *</label>
                <input type="email" id="pay-email" required placeholder="your@email.com"
                  class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white placeholder-gray-600 text-sm focus:outline-none focus:border-yellow-400/60 transition-colors" />
              </div>
            </div>

            <div>
              <label class="block text-gray-400 text-xs uppercase tracking-widest font-semibold mb-2">Group Size</label>
              <select id="pay-group" class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-yellow-400/60 transition-colors appearance-none">
                <option value="1">Just me (1 person)</option>
                <option value="2">2 People</option>
                <option value="3-4">3–4 People</option>
                <option value="5-8">5–8 People</option>
                <option value="9+">9+ People (large group)</option>
              </select>
            </div>

            <div>
              <label class="block text-gray-400 text-xs uppercase tracking-widest font-semibold mb-2">Special Requests</label>
              <textarea id="pay-notes" rows="2" placeholder="Birthday, anniversary, dietary needs, accessibility..."
                class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white placeholder-gray-600 text-sm focus:outline-none focus:border-yellow-400/60 transition-colors resize-none"></textarea>
            </div>

            <!-- Discount code -->
            <div class="flex gap-2">
              <input type="text" id="pay-discount" placeholder="Discount code (e.g. DUNE100)"
                class="flex-grow bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white placeholder-gray-600 text-sm focus:outline-none focus:border-yellow-400/60 transition-colors" />
              <button type="button" id="apply-code-btn" class="btn-outline px-4 py-3 rounded-xl text-sm font-display whitespace-nowrap">Apply</button>
            </div>
            <div id="code-msg" class="text-xs hidden"></div>

            <!-- Pay button -->
            <button type="submit" id="final-pay-btn"
              class="btn-gold w-full flex items-center justify-center gap-3 py-5 rounded-2xl text-lg shine group mt-2">
              <i class="fas fa-lock text-base"></i>
              <span class="font-display tracking-wide" id="final-pay-text">Pay Securely Now</span>
              <i class="fas fa-arrow-right text-base group-hover:translate-x-1 transition-transform"></i>
            </button>
          </form>

          <!-- Trust row -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs text-gray-600">
            <span class="flex items-center gap-1.5"><i class="fab fa-stripe text-purple-400 text-base"></i> Powered by Stripe</span>
            <span class="flex items-center gap-1.5"><i class="fas fa-shield-alt text-green-400"></i> 256-bit SSL</span>
            <span class="flex items-center gap-1.5"><i class="fas fa-credit-card text-blue-400"></i> Visa · MC · Amex</span>
            <span class="flex items-center gap-1.5"><i class="fas fa-undo text-yellow-400/60"></i> Free rescheduling</span>
          </div>

          <div class="mt-5 text-center">
            <button onclick="goToStep(3)" class="text-gray-600 hover:text-gray-400 text-sm underline transition-colors">
              <i class="fas fa-arrow-left mr-1"></i> Back to offer
            </button>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script define:vars={{ buggies }}>
(function () {

  const DISCOUNT_CODES = {
    DUNE100:  { off: 100 },
    SAHARA50: { off: 50  },
    VIP200:   { off: 200 },
  };

  let selectedBuggy = null;
  let selectedDate  = null;
  let selectedSlot  = null;
  let discount      = 0;
  let currentStep   = 1;

  // ── Pre-select from URL param ─────────────────────────────
  const params   = new URLSearchParams(window.location.search);
  const preselect = params.get('buggy');

  if (preselect) {
    const match = buggies.find(b => b.id === preselect);
    if (match) {
      setTimeout(() => selectBuggy(match.id), 100);
    }
  }

  // Set tomorrow as min date
  const dateInput = document.getElementById('booking-date');
  const tomorrow  = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  dateInput.min   = tomorrow.toISOString().split('T')[0];
  dateInput.value = tomorrow.toISOString().split('T')[0];
  selectedDate    = dateInput.value;
  dateInput.addEventListener('change', () => { selectedDate = dateInput.value; });

  // ── Step navigation ───────────────────────────────────────
  window.goToStep = function (n) {
    if (n === 2 && !selectedBuggy) {
      alert('Please select a buggy first!');
      return;
    }
    if (n === 3 && !selectedSlot) {
      alert('Please select a timeslot first!');
      return;
    }
    currentStep = n;
    document.querySelectorAll('.step-section').forEach(el => el.classList.add('hidden'));
    document.getElementById('step-' + n).classList.remove('hidden');
    updateProgress(n);
    if (n === 3) populateOffer();
    if (n === 4) populateSummary();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  function updateProgress(step) {
    [1, 2, 3, 4].forEach(n => {
      const circle = document.getElementById('step-circle-' + n);
      const label  = document.getElementById('step-label-' + n);
      if (n < step) {
        circle.className = 'w-7 h-7 md:w-8 md:h-8 rounded-full flex items-center justify-center text-xs md:text-sm font-bold transition-all duration-300 bg-green-500 text-white';
        circle.innerHTML = '<i class="fas fa-check text-xs"></i>';
      } else if (n === step) {
        circle.className = 'w-7 h-7 md:w-8 md:h-8 rounded-full flex items-center justify-center text-xs md:text-sm font-bold transition-all duration-300 bg-yellow-400 text-black';
        circle.innerHTML = n;
        label.classList.remove('text-gray-600');
        label.classList.add('text-yellow-400');
      } else {
        circle.className = 'w-7 h-7 md:w-8 md:h-8 rounded-full flex items-center justify-center text-xs md:text-sm font-bold transition-all duration-300 bg-black/40 border border-yellow-400/20 text-gray-500';
        circle.innerHTML = n;
        label.classList.add('text-gray-600');
        label.classList.remove('text-yellow-400');
      }
      if (n < 4) {
        const bar = document.getElementById('step-bar-' + n);
        if (bar) bar.style.width = n < step ? '100%' : '0%';
      }
    });
  }

  // ── Select buggy ──────────────────────────────────────────
  function selectBuggy(id) {
    selectedBuggy = buggies.find(b => b.id === id);
    document.querySelectorAll('.buggy-card').forEach(card => {
      const overlay = card.querySelector('.selected-overlay');
      if (card.dataset.buggyId === id) {
        overlay.classList.remove('hidden');
        card.style.borderColor = selectedBuggy.color + '80';
      } else {
        overlay.classList.add('hidden');
        card.style.borderColor = '';
      }
    });
    // Short delay then advance
    setTimeout(() => goToStep(2), 350);
    // Update step2 summary
    document.getElementById('step2-buggy-name').textContent  = selectedBuggy.name;
    document.getElementById('step2-buggy-price').textContent = `AED ${selectedBuggy.price} / 30 min`;
    document.getElementById('step2-buggy-img').src           = selectedBuggy.image;
    document.getElementById('step2-buggy-img').alt           = selectedBuggy.name;
  }

  document.querySelectorAll('.buggy-card').forEach(card => {
    card.addEventListener('click', () => selectBuggy(card.dataset.buggyId));
  });

  // ── Select timeslot ───────────────────────────────────────
  document.querySelectorAll('.timeslot-btn:not([disabled])').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.timeslot-btn').forEach(b => {
        b.classList.remove('border-yellow-400', 'bg-yellow-400/10', 'text-yellow-400');
        b.classList.add('border-yellow-400/20', 'bg-black/30');
        b.querySelectorAll('div').forEach(d => d.classList.remove('text-yellow-400'));
      });
      btn.classList.add('border-yellow-400', 'bg-yellow-400/10');
      selectedSlot = { id: btn.dataset.slotId, label: btn.dataset.slotLabel };
      document.getElementById('step2-next').disabled = false;
      document.getElementById('step2-next').classList.remove('opacity-50', 'cursor-not-allowed');
    });
  });

  // ── Populate offer (Step 3) ───────────────────────────────
  function populateOffer() {
    if (!selectedBuggy || !selectedSlot) return;
    const bonusValue = 1300;
    const total = selectedBuggy.price + bonusValue;
    document.getElementById('offer-buggy-name').textContent  = selectedBuggy.name;
    document.getElementById('offer-buggy-price').textContent = selectedBuggy.price.toLocaleString();
    document.getElementById('offer-slot-summary').textContent = `${formatDate(selectedDate)} · ${selectedSlot.label}`;
    document.getElementById('offer-total-value').textContent  = `AED ${total.toLocaleString()}`;
    document.getElementById('offer-final-price').textContent  = selectedBuggy.price.toLocaleString();
    // Random slots 2-4 for urgency
    document.getElementById('slots-left').textContent = Math.floor(Math.random() * 3) + 2;
  }

  // ── Populate summary (Step 4) ─────────────────────────────
  function populateSummary() {
    if (!selectedBuggy) return;
    document.getElementById('s4-buggy').textContent = selectedBuggy.name;
    document.getElementById('s4-date').textContent  = formatDate(selectedDate);
    document.getElementById('s4-time').textContent  = selectedSlot ? selectedSlot.label : '';
    document.getElementById('s4-price').textContent = `AED ${(selectedBuggy.price - discount).toLocaleString()}`;
    document.getElementById('final-pay-text').textContent = `Pay AED ${(selectedBuggy.price - discount).toLocaleString()} Securely`;
  }

  function formatDate(dateStr) {
    if (!dateStr) return '';
    const d = new Date(dateStr + 'T00:00:00');
    return d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
  }

  // ── Discount code ─────────────────────────────────────────
  document.getElementById('apply-code-btn')?.addEventListener('click', () => {
    const code  = document.getElementById('pay-discount').value.trim().toUpperCase();
    const msgEl = document.getElementById('code-msg');
    const dc    = DISCOUNT_CODES[code];
    if (!dc) {
      msgEl.textContent = 'Invalid discount code.';
      msgEl.className   = 'text-xs text-red-400';
      msgEl.classList.remove('hidden');
      discount = 0;
    } else {
      discount = dc.off;
      msgEl.textContent = `AED ${dc.off} off applied!`;
      msgEl.className   = 'text-xs text-green-400';
      msgEl.classList.remove('hidden');
      const price = Math.max(0, selectedBuggy.price - discount);
      document.getElementById('s4-price').textContent         = `AED ${price.toLocaleString()}`;
      document.getElementById('final-pay-text').textContent   = `Pay AED ${price.toLocaleString()} Securely`;
    }
  });

  // ── Form submit → Stripe ──────────────────────────────────
  document.getElementById('payment-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('final-pay-btn');
    btn.disabled = true;
    document.getElementById('final-pay-text').textContent = 'Creating secure checkout...';

    // Map buggy to package id
    const pkgMap = {
      'kymco-mxu-250':                      'explorer',
      'can-am-maverick-r-x-rs-2025':        'vip',
      'can-am-maverick-3x-turbo-rr-2-seater': 'adventurer',
      'can-am-maverick-3x-turbo-rr-4-seater': 'dune_master',
      'polaris-rzr-2-seater-1000xp':         'explorer',
      'polaris-rzr-4-seater-1000xp':         'adventurer',
      'cf-moto-1000cc-4x4':                  'explorer',
      'can-am-maverick-r-x-rs-2024':         'dune_master',
    };

    try {
      const res = await fetch('/api/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          packageId:     pkgMap[selectedBuggy.id] || 'explorer',
          buggyName:     selectedBuggy.name,
          customerName:  document.getElementById('pay-name').value,
          customerEmail: document.getElementById('pay-email').value,
          date:          selectedDate + ' ' + (selectedSlot?.label || ''),
          groupSize:     document.getElementById('pay-group').value,
          notes:         document.getElementById('pay-notes').value,
          discountCode:  document.getElementById('pay-discount').value.trim().toUpperCase() || null,
        }),
      });

      const data = await res.json();

      if (data.url) {
        window.location.href = data.url;
      } else {
        throw new Error(data.error || 'Payment setup failed');
      }
    } catch (err) {
      alert('Payment error: ' + err.message + '\nPlease try WhatsApp booking instead.');
      btn.disabled = false;
      document.getElementById('final-pay-text').textContent = 'Pay Securely Now';
    }
  });

})();
</script>
