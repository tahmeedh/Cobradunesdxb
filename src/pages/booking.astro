---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const buggies = [
  {
    id: "kymco-mxu-250",
    name: "Kymco MXU 250",
    seats: "1 Seater",
    engine: "250cc",
    power: "18 HP",
    speed: "90 km/h",
    price: 150,
    tag: "Solo Ride",
    tagColor: "bg-yellow-400 text-black",
    description: "A lightweight quad for solo desert explorers.",
    image: "https://cobradunesdxb.com/wp-content/uploads/2025/12/kymco-quad-ride-1024x1024.webp",
    color: "#FBBF24",
  },
  {
    id: "can-am-maverick-r-x-rs-2025",
    name: "Can-Am Maverick R X RS 2025",
    seats: "4 Seater",
    engine: "900cc Turbo",
    power: "120 HP",
    speed: "120 km/h",
    price: 800,
    tag: "Premium",
    tagColor: "bg-green-500 text-white",
    description: "Dubai's most powerful buggy — the flagship experience.",
    image: "https://cobradunesdxb.com/wp-content/uploads/2025/11/CAN-AM-MAVERICK-R-X-RS-2025-1-1024x960.webp",
    color: "#4ADE80",
  },
  {
    id: "can-am-maverick-3x-turbo-rr-2-seater",
    name: "Can-Am Maverick 3X Turbo RR (2-Seat)",
    seats: "2 Seater",
    engine: "900cc Turbo",
    power: "120 HP",
    speed: "120 km/h",
    price: 550,
    tag: "Couple Adventure",
    tagColor: "bg-blue-500 text-white",
    description: "Sporty 2-seater delivering precision handling and thrills.",
    image: "https://cobradunesdxb.com/wp-content/uploads/2025/11/CAN-MA-Maverick-3X-turbo-RR-2-seater--1008x1024.webp",
    color: "#60A5FA",
  },
  {
    id: "can-am-maverick-3x-turbo-rr-4-seater",
    name: "Can-Am Maverick 3X Turbo RR (4-Seat)",
    seats: "4 Seater",
    engine: "900cc Turbo",
    power: "120 HP",
    speed: "120 km/h",
    price: 600,
    tag: "Group Ride",
    tagColor: "bg-purple-500 text-white",
    description: "Powerful 4-seater for friends wanting shared thrills.",
    image: "https://cobradunesdxb.com/wp-content/uploads/2025/11/CAN-AM-Maverick-3X-turbo-RR-4-seater--1008x1024.webp",
    color: "#A855F7",
  },
  {
    id: "polaris-rzr-2-seater-1000xp",
