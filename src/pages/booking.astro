    tag: "Family Quad",
    tagColor: "bg-blue-800 text-white",
    description: "Roomy Polaris for comfortable group dune rides.",
    image: "https://cobradunesdxb.com/wp-content/uploads/2025/11/Polaris-RZR-1000XP-4-seater-1007x1024.webp",
    color: "#1D4ED8",
  },
  {
    id: "cf-moto-1000cc-4x4",
    name: "CF Moto 1000CC 4x4",
    seats: "2 Seater",
    engine: "1000cc",
    power: "112 HP",
    speed: "115 km/h",
    price: 249,
    tag: "Best Value",
    tagColor: "bg-red-500 text-white",
    description: "Rugged 2-seater with serious torque — power at great value.",
    image: "https://cobradunesdxb.com/wp-content/uploads/2025/11/CF-MOTO-1000CC-4X4--1008x1024.webp",
    color: "#EF4444",
  },
  {
    id: "can-am-maverick-r-x-rs-2024",
    name: "Can-Am Maverick R X RS 2024",
    seats: "4 Seater",
    engine: "900cc Turbo",
    power: "120 HP",
    speed: "120 km/h",
    price: 700,
    tag: "Retro Edition",
    tagColor: "bg-amber-500 text-black",
    description: "Classic Can-Am power — thrilling performance for groups.",
    image: "https://cobradunesdxb.com/wp-content/uploads/2025/11/CAN-AM-MAVERICK-R-X-RS-2024-1015x1024.webp",
    color: "#F59E0B",
  },
