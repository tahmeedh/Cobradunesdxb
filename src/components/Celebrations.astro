---
const occasions = [
  { icon: "🎂", label: "Birthdays"        },
  { icon: "💍", label: "Proposals"        },
  { icon: "💑", label: "Anniversaries"    },
  { icon: "🏢", label: "Corporate Events" },
  { icon: "👰", label: "Hen/Stag Parties" },
  { icon: "🎓", label: "Graduations"      },
  { icon: "🌍", label: "Tourist Groups"   },
  { icon: "🏆", label: "Team Building"    },
];

const packages = [
  {
    name:  "Romantic Desert Escape",
    for:   "Couples",
    price: "From AED 1,200",
    icon:  "fas fa-heart",
    color: "text-pink-400",
    border:"border-pink-400/30",
    includes: [
      "Private 2-hour sunset buggy ride",
      "Rose petal & candle desert setup",
      "Gourmet picnic basket",
      "Professional photography (30 min)",
      "Chilled beverages & chocolates",
      "Hotel transfers (optional)",
    ],
  },
  {
    name:  "Desert Birthday Bash",
    for:   "Groups up to 20",
    price: "From AED 2,500",
    icon:  "fas fa-birthday-cake",
    color: "text-yellow-400",
    border:"border-yellow-400/30",
    includes: [
      "1-hour group buggy convoy",
      "Custom birthday cake & decoration",
      "Catered desert feast",
      "Bonfire & live music",
      "Group photography session",
      "Balloon arch & personalized banner",
    ],
    featured: true,
  },
  {
    name:  "Corporate Desert Team Build",
    for:   "Teams up to 50",
    price: "From AED 5,000",
    icon:  "fas fa-briefcase",
    color: "text-blue-400",
    border:"border-blue-400/30",
    includes: [
      "Guided group buggy experience",
      "Branded activation options",
      "Desert BBQ & catering",
      "Team challenges & activities",
      "Professional event coordination",
      "Full AV & photography package",
    ],
  },
];
---

<section id="celebrations" class="section-padding bg-[#0D0D0D] relative overflow-hidden">

  <!-- Background decorative elements -->
  <div class="absolute inset-0 bg-stripes opacity-30"></div>
  <div class="blur-orb w-[500px] h-[500px] bg-yellow-400/4 top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2"></div>

  <!-- Top/Bottom borders -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-400/40 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-400/40 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <span class="text-yellow-400/60 text-sm tracking-widest uppercase font-semibold">Make It Unforgettable</span>
      <h2 class="section-title text-5xl md:text-7xl text-white mt-3">
        DESERT <span class="text-gradient-gold">CELEBRATIONS</span>
      </h2>
      <div class="gold-line mt-4 mb-6"></div>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Turn the golden sands of Dubai into the backdrop for your most special moments.
        We specialise in crafting bespoke desert celebration experiences.
      </p>
    </div>

    <!-- Occasions pill cloud -->
    <div class="flex flex-wrap justify-center gap-3 mb-16" data-aos="fade-up" data-aos-delay="100">
      {occasions.map(o => (
        <div class="flex items-center gap-2 px-4 py-2.5 glass border border-yellow-400/15 rounded-full text-gray-300 text-sm font-medium hover:border-yellow-400/40 hover:text-yellow-400 transition-all duration-300 cursor-default">
          <span class="text-lg">{o.icon}</span>
          {o.label}
        </div>
      ))}
    </div>

    <!-- Two-column: Image + Description -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-20">

      <!-- Left: Visual -->
      <div class="relative" data-aos="fade-right">
        <div class="relative rounded-2xl overflow-hidden aspect-[4/3] border border-yellow-400/15">
          <!-- Desert celebration photo -->
          <img
            src="https://images.unsplash.com/photo-1534940801-92358b7eb53c?w=800&h=600&fit=crop&q=80"
            alt="Desert celebration under the stars Dubai"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <!-- Overlay for badge legibility -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>

          <!-- Floating achievement badges -->
          <div class="absolute top-4 left-4 glass border border-yellow-400/30 rounded-xl px-3 py-2 shadow-gold">
            <div class="text-yellow-400 font-bold text-sm">⭐ 5-Star Events</div>
            <div class="text-gray-400 text-xs">Since 2019</div>
          </div>
          <div class="absolute bottom-4 right-4 glass border border-yellow-400/30 rounded-xl px-3 py-2 shadow-gold">
            <div class="text-yellow-400 font-bold text-sm">500+ Events</div>
            <div class="text-gray-400 text-xs">Successfully Hosted</div>
          </div>
        </div>
      </div>

      <!-- Right: Content -->
      <div data-aos="fade-left">
        <h3 class="section-title text-4xl md:text-5xl text-white mb-4">
          YOUR EVENT,<br/>
          <span class="text-gradient-gold">OUR CANVAS</span>
        </h3>
        <p class="text-gray-400 leading-relaxed mb-6">
          The desert provides a breathtaking natural backdrop unlike any other venue on earth.
          At Cobra Dunes DXB, we transform the golden sands of Dubai into personalised celebration
          spaces that reflect your style and create memories that endure forever.
        </p>
        <p class="text-gray-400 leading-relaxed mb-8">
          From intimate romantic escapes for two to large corporate gatherings of 50+,
          our dedicated events team handles every detail — so you can focus on living the moment.
        </p>

        <!-- Feature list -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
          {[
            "Full Event Planning",
            "Custom Decoration",
            "Desert Catering",
            "Photography & Video",
            "Live Entertainment",
            "Hotel Transfers",
            "Safety Coordination",
            "24/7 Support",
          ].map(f => (
            <div class="flex items-center gap-2 text-gray-300 text-sm">
              <div class="w-5 h-5 rounded bg-yellow-400/15 flex items-center justify-center flex-shrink-0">
                <i class="fas fa-check text-yellow-400 text-xs"></i>
              </div>
              {f}
            </div>
          ))}
        </div>

        <a
          href="https://wa.me/971505371693?text=Hi! I want to plan a desert celebration event"
          target="_blank"
          rel="noopener"
          class="btn-gold inline-flex items-center gap-2 px-6 py-3.5 rounded-xl shine"
        >
          <i class="fab fa-whatsapp text-lg"></i>
          <span class="font-display text-lg">Plan Your Celebration</span>
        </a>
      </div>

    </div>

    <!-- Celebration Packages -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {packages.map((pkg, i) => (
        <div
          class={`relative border-gradient rounded-2xl p-6 bg-[#161616] hover:-translate-y-2 transition-all duration-400 ${pkg.featured ? 'ring-2 ring-yellow-400/50' : ''}`}
          data-aos="fade-up"
          data-aos-delay={i * 100}
        >
          {pkg.featured && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="btn-gold text-xs font-bold px-4 py-1 rounded-full">Most Popular</span>
            </div>
          )}

          <div class={`w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-400/20 to-transparent border ${pkg.border} flex items-center justify-center mb-4`}>
            <i class={`${pkg.icon} ${pkg.color} text-xl`}></i>
          </div>

          <h4 class="font-display text-xl text-white mb-1">{pkg.name}</h4>
          <p class="text-gray-500 text-sm mb-2">For {pkg.for}</p>
          <p class={`font-racing text-xl ${pkg.color} mb-5`}>{pkg.price}</p>

          <ul class="space-y-2 mb-6">
            {pkg.includes.map(item => (
              <li class="flex items-start gap-2 text-sm text-gray-300">
                <i class="fas fa-check text-yellow-400/70 text-xs mt-0.5 flex-shrink-0"></i>
                {item}
              </li>
            ))}
          </ul>

          <a
            href={`https://wa.me/971505371693?text=Hi! I'm interested in the ${pkg.name} package`}
            target="_blank"
            rel="noopener"
            class={`w-full flex items-center justify-center gap-2 py-2.5 rounded-xl text-sm font-display tracking-wide transition-all duration-300 ${pkg.featured ? 'btn-gold shine' : 'btn-outline'}`}
          >
            <i class="fas fa-calendar-plus"></i>
            Enquire Now
          </a>
        </div>
      ))}
    </div>

  </div>
</section>
