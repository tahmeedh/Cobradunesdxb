<section id="fleet" class="section-padding bg-[#0D0D0D] relative overflow-hidden">

  <!-- Background elements -->
  <div class="blur-orb w-[600px] h-[600px] bg-yellow-400/3 top-1/4 left-1/2 -translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <span class="text-yellow-400/60 text-sm tracking-widest uppercase font-semibold">Premium Off-Road Machines</span>
      <h2 class="section-title text-5xl md:text-7xl text-white mt-3">
        OUR <span class="text-gradient-gold">FLEET</span>
      </h2>
      <div class="gold-line mt-4 mb-6"></div>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Choose from our fleet of premium, meticulously maintained desert buggies —
        each built to conquer Dubai's most challenging dunes.
      </p>
    </div>

    <!-- Buggy Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 lg:gap-8">
      {buggies.map((buggy, i) => (
        <div
          class={`relative border-gradient rounded-2xl overflow-hidden card-3d group cursor-pointer bg-[#161616]`}
          data-aos="fade-up"
          data-aos-delay={i * 80}
        >
          <!-- Tag -->
          <div class="absolute top-4 right-4 z-10">
            <span class={`${buggy.tagColor} text-xs font-bold px-3 py-1 rounded-full shadow-lg`}>
              {buggy.tag}
            </span>
          </div>

          <!-- Emoji badge -->
          <div class="absolute top-4 left-4 z-10 text-2xl">{buggy.badge}</div>

          <!-- Image Area -->
          <div class={`relative h-52 bg-gradient-to-br ${buggy.gradient} overflow-hidden`}>
            <img
              src={buggy.image}
              alt={`${buggy.name} dune buggy Dubai`}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              loading="lazy"
            />
            <!-- Darkening overlay for text legibility -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            <!-- Color accent line -->
            <div class="absolute bottom-0 left-0 right-0 h-1" style={`background: linear-gradient(90deg, transparent, ${buggy.color}, transparent);`}></div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <!-- Name & Seats -->
            <div class="flex items-start justify-between mb-3">
              <div>
                <h3 class="font-display text-xl text-white leading-tight">{buggy.name}</h3>
                <span class="flex items-center gap-1.5 text-gray-400 text-sm mt-1">
                  <i class="fas fa-users text-xs" style={`color: ${buggy.color};`}></i>
                  {buggy.seats}
                </span>
              </div>
              <div class="text-right">
                <div class="font-racing text-2xl text-yellow-400">AED {buggy.price}</div>
                <div class="text-gray-500 text-xs">per 30 min</div>
              </div>
            </div>

            <!-- Description -->
            <p class="text-gray-400 text-sm leading-relaxed mb-4 line-clamp-2">{buggy.description}</p>

            <!-- Specs Grid -->
            <div class="grid grid-cols-3 gap-2 mb-4">
              {[
                { label: "Engine", value: buggy.engine },
                { label: "Power",  value: buggy.power  },
                { label: "Speed",  value: buggy.speed  },
              ].map(spec => (
                <div class="text-center p-2 rounded-lg bg-black/30 border border-yellow-400/10">
                  <div class="text-yellow-400/80 text-xs font-bold leading-tight">{spec.value}</div>
                  <div class="text-gray-600 text-xs">{spec.label}</div>
                </div>
              ))}
            </div>

            <!-- Features -->
            <div class="flex flex-wrap gap-1.5 mb-5">
              {buggy.features.slice(0, 4).map(f => (
                <span class="text-xs px-2 py-0.5 rounded-md bg-yellow-400/10 text-yellow-400/80 border border-yellow-400/10 font-medium">
                  {f}
                </span>
              ))}
              {buggy.features.length > 4 && (
                <span class="text-xs px-2 py-0.5 rounded-md bg-gray-800 text-gray-500">
                  +{buggy.features.length - 4} more
                </span>
              )}
            </div>

            <!-- Book CTA -->
            <a
              href={`https://wa.me/971505371693?text=Hi! I want to book the ${buggy.name} for a desert adventure`}
              target="_blank"
              rel="noopener"
              class="btn-gold w-full flex items-center justify-center gap-2 py-3 rounded-xl text-sm shine"
            >
              <i class="fab fa-whatsapp text-base"></i>
              <span class="font-display tracking-wide">Book {buggy.name}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Fleet CTA Banner -->
    <div class="mt-12 text-center" data-aos="fade-up">
      <div class="glass border border-yellow-400/20 rounded-2xl p-8 max-w-2xl mx-auto">
        <h3 class="font-display text-2xl text-white mb-2">Not sure which buggy to choose?</h3>
        <p class="text-gray-400 mb-6">Our desert adventure experts will help you pick the perfect machine for your group and experience level.</p>
        <a
          href="https://wa.me/971505371693?text=Hi! I need help choosing the right buggy for my group"
          target="_blank"
          rel="noopener"
          class="btn-gold inline-flex items-center gap-2 px-6 py-3 rounded-xl shine"
        >
          <i class="fab fa-whatsapp text-lg"></i>
          <span class="font-display">Get Expert Advice</span>
        </a>
      </div>
    </div>

  </div>
</section>
