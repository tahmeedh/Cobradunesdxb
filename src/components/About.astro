---
const skills = [
  { label: "Front-End Development",   level: 98, color: "bg-yellow-400"   },
  { label: "UI/UX Design",            level: 96, color: "bg-orange-400"   },
  { label: "3D & Motion Design",      level: 92, color: "bg-purple-400"   },
  { label: "SEO Optimisation",        level: 97, color: "bg-green-400"    },
  { label: "Performance Engineering", level: 95, color: "bg-blue-400"     },
  { label: "Conversion Rate Optim.",  level: 94, color: "bg-pink-400"     },
];

const whyUs = [
  {
    icon:  "fas fa-award",
    title: "Premium Fleet",
    desc:  "Only the top-tier Can-Am & Polaris machines, serviced after every tour.",
    color: "text-yellow-400",
  },
  {
    icon:  "fas fa-user-shield",
    title: "Certified Guides",
    desc:  "All instructors are desert-trained, first-aid certified, and safety-obsessed.",
    color: "text-green-400",
  },
  {
    icon:  "fas fa-map-marked-alt",
    title: "Exclusive Routes",
    desc:  "Proprietary dune routes through Big Red & Al Marmoom for the best views.",
    color: "text-blue-400",
  },
  {
    icon:  "fas fa-heart",
    title: "5-Star Memories",
    desc:  "Over 847 five-star reviews. We don't just run tours — we craft stories.",
    color: "text-pink-400",
  },
  {
    icon:  "fas fa-leaf",
    title: "Eco-Conscious",
    desc:  "We operate sustainably, respecting Dubai's pristine desert ecosystem.",
    color: "text-emerald-400",
  },
  {
    icon:  "fas fa-clock",
    title: "Flexible Timing",
    desc:  "Dawn to dusk, weekdays or weekends — we operate 365 days a year.",
    color: "text-amber-400",
  },
];
---

<section id="about" class="section-padding bg-[#0D0D0D] relative overflow-hidden">

  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-400/40 to-transparent"></div>
  <div class="blur-orb w-[500px] h-[500px] bg-yellow-400/4 -bottom-20 -left-20"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <span class="text-yellow-400/60 text-sm tracking-widest uppercase font-semibold">Our Story</span>
      <h2 class="section-title text-5xl md:text-7xl text-white mt-3">
        ABOUT <span class="text-gradient-gold">COBRA DUNES</span>
      </h2>
      <div class="gold-line mt-4"></div>
    </div>

    <!-- About content -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-20">

      <!-- Left: Content -->
      <div data-aos="fade-right">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass border border-yellow-400/30 text-yellow-400 text-sm font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
          Est. 2019 · Dubai, UAE
        </div>

        <h3 class="section-title text-4xl text-white mb-4">
          BORN FROM A<br/>
          <span class="text-gradient-gold">LOVE OF ADVENTURE</span>
        </h3>

        <p class="text-gray-400 leading-relaxed mb-4">
          Cobra Dunes DXB was born from a deep passion for Dubai's magnificent desert landscape
          and a belief that everyone deserves access to world-class off-road adventures.
          Founded in 2019, we've grown from a small local operator into Dubai's most trusted
          desert buggy company.
        </p>

        <p class="text-gray-400 leading-relaxed mb-8">
          Our fleet of premium Can-Am Maverick and Polaris RZR machines are maintained to
          factory standards, ensuring every ride is as safe as it is exhilarating. From
          solo adventurers to families, couples celebrating anniversaries, and corporate
          groups — we tailor every experience to be perfect.
        </p>

        <!-- Quote -->
        <blockquote class="border-l-4 border-yellow-400 pl-6 italic text-gray-300 text-lg mb-8">
          "The desert doesn't just test you — it transforms you.
          We're here to make sure that transformation is incredible."
          <footer class="text-yellow-400/70 text-sm font-semibold not-italic mt-2 ml-0">
            — Cobra Dunes Founding Team
          </footer>
        </blockquote>

        <div class="flex flex-wrap gap-4">
          <a href="#experiences" class="btn-gold inline-flex items-center gap-2 px-6 py-3 rounded-xl shine">
            <i class="fas fa-compass"></i>
            <span class="font-display">Explore Experiences</span>
          </a>
          <a href="#fleet" class="btn-outline inline-flex items-center gap-2 px-6 py-3 rounded-xl">
            <i class="fas fa-car"></i>
            <span class="font-display">Our Fleet</span>
          </a>
        </div>
      </div>

      <!-- Right: Why Us Grid -->
      <div data-aos="fade-left">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {whyUs.map((item, i) => (
            <div
              class="glass border border-yellow-400/10 rounded-xl p-5 hover:border-yellow-400/30 hover:-translate-y-1 transition-all duration-300 group"
              data-aos="fade-up"
              data-aos-delay={i * 70}
            >
              <div class={`${item.color} text-xl mb-3 group-hover:scale-110 inline-block transition-transform duration-300`}>
                <i class={item.icon}></i>
              </div>
              <h4 class="font-display text-base text-white mb-1 group-hover:text-yellow-400 transition-colors">{item.title}</h4>
              <p class="text-gray-500 text-xs leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Skills / Expertise Section (as requested: FE dev + UI/UX pro) -->
    <div class="mt-8" data-aos="fade-up">
      <div class="glass border border-yellow-400/15 rounded-2xl p-8 md:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div>
            <span class="text-yellow-400/60 text-sm tracking-widest uppercase font-semibold">Built by Experts</span>
            <h3 class="section-title text-3xl md:text-4xl text-white mt-2 mb-4">
              CRAFTED WITH<br/>
              <span class="text-gradient-gold">PRO-MAX SKILLS</span>
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              This website was engineered with cutting-edge front-end development and
              UI/UX design principles — delivering a premium digital experience
              that matches the world-class adventures Cobra Dunes provides.
            </p>
          </div>

          <div class="space-y-4">
            {skills.map((skill, i) => (
              <div data-aos="fade-left" data-aos-delay={i * 60}>
                <div class="flex justify-between items-center mb-1.5">
                  <span class="text-gray-300 text-sm font-medium">{skill.label}</span>
                  <span class="text-yellow-400 text-sm font-bold">{skill.level}%</span>
                </div>
                <div class="h-1.5 bg-gray-800 rounded-full overflow-hidden">
                  <div
                    class={`h-full ${skill.color} rounded-full skill-bar`}
                    data-width={skill.level}
                    style="width: 0%"
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  // Animate skill bars on scroll
  const skillBars = document.querySelectorAll('.skill-bar');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const bar = entry.target as HTMLElement;
        const width = bar.dataset.width || '0';
        setTimeout(() => {
          bar.style.width = width + '%';
          bar.style.transition = 'width 1.5s cubic-bezier(0.4, 0, 0.2, 1)';
        }, 200);
        observer.unobserve(bar);
      }
    });
  }, { threshold: 0.3 });

  skillBars.forEach(bar => observer.observe(bar));
</script>
