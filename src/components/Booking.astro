---
const fleetVehicles = [
  { name: 'Kymco MXU 250', seats: '1 Seater', price: 'AED 150 / 30min', image: 'https://cobradunesdxb.com/wp-content/uploads/2025/12/kymco-quad-ride-1024x1024.webp' },
  { name: 'Buggy CAN AM MAVERICK R X RS 2025', seats: '4 Seater', price: 'AED 800 / 30min', image: 'https://cobradunesdxb.com/wp-content/uploads/2025/11/CAN-AM-MAVERICK-R-X-RS-2025-1-1024x960.webp' },
  { name: 'CAN AM Maverick 3X turbo RR 2 seater', seats: '2 Seater', price: 'AED 550 / 30min', image: 'https://cobradunesdxb.com/wp-content/uploads/2025/11/CAN-MA-Maverick-3X-turbo-RR-2-seater--1008x1024.webp' },
  { name: 'CAN AM Maverick 3X turbo RR 4 seater', seats: '4 Seater', price: 'AED 600 / 30min', image: 'https://cobradunesdxb.com/wp-content/uploads/2025/11/CAN-AM-Maverick-3X-turbo-RR-4-seater--1008x1024.webp' },
  { name: 'Polaris RZR 2 seater 1000XP', seats: '2 Seater', price: 'AED 400 / 30min', image: 'https://cobradunesdxb.com/wp-content/uploads/2025/11/Polaris-RZR-2-seater-1000XP--994x1024.webp' },
  { name: 'Polaris RZR 4 seater 1000XP', seats: '4 Seater', price: 'AED 450 / 30min', image: 'https://cobradunesdxb.com/wp-content/uploads/2025/11/Polaris-RZR-1000XP-4-seater-1007x1024.webp' },
  { name: 'CF MOTO 1000CC 4X4', seats: '2 Seater', price: 'AED 249 / 30min', image: 'https://cobradunesdxb.com/wp-content/uploads/2025/11/CF-MOTO-1000CC-4X4--1008x1024.webp' },
  { name: 'CAN AM MAVERICK R X RS 2024', seats: '4 Seater', price: 'AED 700 / 30min', image: 'https://cobradunesdxb.com/wp-content/uploads/2025/11/CAN-AM-MAVERICK-R-X-RS-2024-1015x1024.webp' },
];
---

<section id="contact" class="section-padding bg-[#0D0D0D] relative overflow-hidden">

  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-400/40 to-transparent"></div>
  <div class="blur-orb w-[500px] h-[500px] bg-yellow-400/5 top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2"></div>
  <div class="absolute inset-0 bg-stripes opacity-30"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <span class="text-yellow-400/60 text-sm tracking-widest uppercase font-semibold">Let's Get Rolling</span>
      <h2 class="section-title text-5xl md:text-7xl text-white mt-3">
        BOOK YOUR <span class="text-gradient-gold">ADVENTURE</span>
      </h2>
      <div class="gold-line mt-4 mb-6"></div>
      <p class="text-gray-400 text-lg max-w-xl mx-auto">
        Ready to hit the dunes? Fill in the form below and we'll get back to you
        within 30 minutes with a confirmed booking.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">

      <!-- Contact Info Column -->
      <div class="lg:col-span-2 space-y-6" data-aos="fade-right">

        <!-- WhatsApp card -->
        <a
          href="https://wa.me/971505371693?text=Hi!%20I%20want%20to%20book%20a%20desert%20adventure"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-4 glass border border-green-500/30 rounded-2xl p-5 hover:border-green-500/60 hover:-translate-y-1 transition-all duration-300 group"
        >
          <div class="w-14 h-14 rounded-xl bg-green-500/20 flex items-center justify-center flex-shrink-0 group-hover:bg-green-500/30 transition-colors">
            <i class="fab fa-whatsapp text-green-400 text-2xl"></i>
          </div>
          <div>
            <div class="font-display text-white text-base group-hover:text-green-400 transition-colors">WhatsApp (Fastest)</div>
            <div class="text-gray-400 text-sm">+971 50 537 1693</div>
            <div class="text-green-400/60 text-xs mt-1">Avg response: 5 minutes</div>
          </div>
        </a>

        <!-- Phone card -->
        <a
          href="tel:+971505371693"
          class="flex items-center gap-4 glass border border-yellow-400/20 rounded-2xl p-5 hover:border-yellow-400/40 hover:-translate-y-1 transition-all duration-300 group"
        >
          <div class="w-14 h-14 rounded-xl bg-yellow-400/10 flex items-center justify-center flex-shrink-0 group-hover:bg-yellow-400/20 transition-colors">
            <i class="fas fa-phone text-yellow-400 text-xl"></i>
          </div>
          <div>
            <div class="font-display text-white text-base group-hover:text-yellow-400 transition-colors">Call Us</div>
            <div class="text-gray-400 text-sm">+971 50 537 1693</div>
            <div class="text-gray-500 text-xs mt-1">Daily 6:00 AM – 10:00 PM</div>
          </div>
        </a>

        <!-- Email card -->
        <a
          href="mailto:info@cobradunesdxb.com"
          class="flex items-center gap-4 glass border border-yellow-400/20 rounded-2xl p-5 hover:border-yellow-400/40 hover:-translate-y-1 transition-all duration-300 group"
        >
          <div class="w-14 h-14 rounded-xl bg-yellow-400/10 flex items-center justify-center flex-shrink-0 group-hover:bg-yellow-400/20 transition-colors">
            <i class="fas fa-envelope text-yellow-400 text-xl"></i>
          </div>
          <div>
            <div class="font-display text-white text-base group-hover:text-yellow-400 transition-colors">Email Us</div>
            <div class="text-gray-400 text-sm">info@cobradunesdxb.com</div>
            <div class="text-gray-500 text-xs mt-1">Response within 2 hours</div>
          </div>
        </a>

        <!-- Location card -->
        <div class="flex items-center gap-4 glass border border-yellow-400/20 rounded-2xl p-5">
          <div class="w-14 h-14 rounded-xl bg-yellow-400/10 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-map-marker-alt text-yellow-400 text-xl"></i>
          </div>
          <div>
            <div class="font-display text-white text-base">Desert Basecamp</div>
            <div class="text-gray-400 text-sm">Al Lahbab (Big Red), Dubai</div>
            <div class="text-gray-500 text-xs mt-1">~45 min from Dubai City</div>
          </div>
        </div>

        <!-- Fleet preview -->
        <div class="glass border border-yellow-400/15 rounded-2xl p-5">
          <div class="text-gray-400 text-xs uppercase tracking-widest font-semibold mb-4">Buggy & Quad Tours</div>
          <p class="text-gray-400 text-sm leading-relaxed mb-6">
            Browse our premium buggy and quad fleet: ride the desert in top Can-Am, Polaris, Kymco and CF Moto vehicles.
          </p>
          <div class="grid grid-cols-1 gap-4">
            {fleetVehicles.map(vehicle => (
              <div class="flex gap-4 items-center bg-black/30 border border-yellow-400/10 rounded-2xl p-3">
                <img src={vehicle.image} alt={vehicle.name} class="w-20 h-20 rounded-2xl object-cover" />
                <div class="min-w-0">
                  <div class="text-white text-sm font-semibold truncate">{vehicle.name}</div>
                  <div class="text-gray-400 text-xs">{vehicle.seats}</div>
                  <div class="text-yellow-300 text-xs mt-1">{vehicle.price}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Social links -->
        <div class="glass border border-yellow-400/15 rounded-2xl p-5">
          <div class="text-gray-400 text-xs uppercase tracking-widest font-semibold mb-4">Follow Our Adventures</div>
          <div class="flex gap-3">
            {[
              { icon: "fab fa-instagram", href: "https://instagram.com/cobradunesdxb", color: "hover:bg-gradient-to-br hover:from-pink-500 hover:to-orange-400", label: "Instagram" },
              { icon: "fab fa-tiktok",    href: "https://tiktok.com/@cobradunesdxb",  color: "hover:bg-black",   label: "TikTok" },
              { icon: "fab fa-facebook",  href: "https://facebook.com/cobradunesdxb", color: "hover:bg-blue-600", label: "Facebook" },
              { icon: "fab fa-youtube",   href: "https://youtube.com/@cobradunesdxb", color: "hover:bg-red-600",  label: "YouTube" },
            ].map(social => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener"
                aria-label={social.label}
                class={`w-10 h-10 rounded-xl glass border border-yellow-400/15 flex items-center justify-center text-gray-400 hover:text-white ${social.color} transition-all duration-300 hover:border-transparent hover:scale-110`}
              >
                <i class={social.icon}></i>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Booking Form -->
      <div class="lg:col-span-3" data-aos="fade-left">
        <div class="glass border border-yellow-400/20 rounded-2xl p-6 md:p-8">
          <h3 class="font-display text-2xl text-white mb-6 flex items-center gap-2">
            <i class="fas fa-calendar-plus text-yellow-400"></i>
            Quick Booking Form
          </h3>

          <form id="booking-form" class="space-y-4" novalidate>
            <!-- Name + Phone -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-gray-400 text-xs uppercase tracking-wide font-semibold mb-2" for="name">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your full name"
                  class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white placeholder-gray-600 text-sm focus:outline-none focus:border-yellow-400/60 transition-colors"
                />
              </div>
              <div>
                <label class="block text-gray-400 text-xs uppercase tracking-wide font-semibold mb-2" for="phone">
                  Phone / WhatsApp *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="+971 50 537 1693"
                  class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white placeholder-gray-600 text-sm focus:outline-none focus:border-yellow-400/60 transition-colors"
                />
              </div>
            </div>

            <!-- Email -->
            <div>
              <label class="block text-gray-400 text-xs uppercase tracking-wide font-semibold mb-2" for="email">
                Email Address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="your@email.com"
                class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white placeholder-gray-600 text-sm focus:outline-none focus:border-yellow-400/60 transition-colors"
              />
            </div>

            <!-- Experience + Group size -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-gray-400 text-xs uppercase tracking-wide font-semibold mb-2" for="experience">
                  Experience *
                </label>
                <select
                  id="experience"
                  name="experience"
                  required
                  class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-yellow-400/60 transition-colors appearance-none"
                >
                  <option value="" disabled selected class="text-gray-600">Select experience</option>
                  <option value="sunrise">Sunrise Dune Safari (2hr)</option>
                  <option value="sunset">Sunset Desert Tour (3hr)</option>
                  <option value="night">Night Desert Experience (3hr)</option>
                  <option value="combo">Dune Bashing Combo (4hr)</option>
                  <option value="vip">VIP Full Day (8hr)</option>
                  <option value="celebration">Desert Celebration (Custom)</option>
                  <option value="corporate">Corporate Event</option>
                  <option value="custom">Custom Enquiry</option>
                </select>
              </div>
              <div>
                <label class="block text-gray-400 text-xs uppercase tracking-wide font-semibold mb-2" for="group-size">
                  Group Size *
                </label>
                <select
                  id="group-size"
                  name="group_size"
                  required
                  class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-yellow-400/60 transition-colors appearance-none"
                >
                  <option value="" disabled selected class="text-gray-600">How many people?</option>
                  <option value="1">1 Person</option>
                  <option value="2">2 People</option>
                  <option value="3-4">3-4 People</option>
                  <option value="5-8">5-8 People</option>
                  <option value="9-15">9-15 People</option>
                  <option value="16-30">16-30 People</option>
                  <option value="30+">30+ People</option>
                </select>
              </div>
            </div>

            <!-- Preferred date -->
            <div>
              <label class="block text-gray-400 text-xs uppercase tracking-wide font-semibold mb-2" for="date">
                Preferred Date
              </label>
              <input
                type="date"
                id="date"
                name="date"
                class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-yellow-400/60 transition-colors"
              />
            </div>

            <!-- Message -->
            <div>
              <label class="block text-gray-400 text-xs uppercase tracking-wide font-semibold mb-2" for="message">
                Special Requests / Notes
              </label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Any special requirements, celebration details, accessibility needs..."
                class="w-full bg-black/40 border border-yellow-400/20 rounded-xl px-4 py-3 text-white placeholder-gray-600 text-sm focus:outline-none focus:border-yellow-400/60 transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Consent -->
            <div class="flex items-start gap-3">
              <input type="checkbox" id="consent" name="consent" required class="mt-1 accent-yellow-400 flex-shrink-0" />
              <label for="consent" class="text-gray-500 text-xs leading-relaxed">
                I agree to Cobra Dunes DXB's
                <a href="#" class="text-yellow-400 hover:underline">Terms & Conditions</a>
                and
                <a href="#" class="text-yellow-400 hover:underline">Privacy Policy</a>.
                I understand that my details will be used to process my booking enquiry.
              </label>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="btn-gold w-full flex items-center justify-center gap-3 py-4 rounded-xl text-base shine group"
            >
              <i class="fab fa-whatsapp text-xl"></i>
              <span class="font-display text-lg tracking-wide">Send Booking Enquiry</span>
              <i class="fas fa-arrow-right text-sm group-hover:translate-x-1 transition-transform"></i>
            </button>

            <p class="text-center text-gray-600 text-xs">
              <i class="fas fa-lock text-yellow-400/50 mr-1"></i>
              Your information is secure and will only be used for your booking.
            </p>
          </form>

          <!-- Success message (hidden) -->
          <div id="form-success" class="hidden text-center py-8">
            <div class="text-5xl mb-4">🎉</div>
            <h4 class="font-display text-2xl text-yellow-400 mb-2">Enquiry Sent!</h4>
            <p class="text-gray-400 text-sm">We'll contact you via WhatsApp within 30 minutes to confirm your booking.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form    = document.getElementById('booking-form') as HTMLFormElement;
  const success = document.getElementById('form-success') as HTMLElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name       = (document.getElementById('name') as HTMLInputElement).value;
    const phone      = (document.getElementById('phone') as HTMLInputElement).value;
    const experience = (document.getElementById('experience') as HTMLSelectElement).value;
    const groupSize  = (document.getElementById('group-size') as HTMLSelectElement).value;
    const date       = (document.getElementById('date') as HTMLInputElement).value;
    const message    = (document.getElementById('message') as HTMLTextAreaElement).value;

    const text = encodeURIComponent(
      `Hi! I want to book a desert adventure 🏜️\n\n` +
      `Name: ${name}\n` +
      `Phone: ${phone}\n` +
      `Experience: ${experience}\n` +
      `Group Size: ${groupSize}\n` +
      `Preferred Date: ${date || 'Flexible'}\n` +
      `Notes: ${message || 'None'}\n\n` +
      `Looking forward to hearing from you!`
    );

    // Open WhatsApp with pre-filled message
    window.open(`https://wa.me/971505371693?text=${text}`, '_blank');

    // Show success
    form.style.display = 'none';
    success.classList.remove('hidden');
  });
</script>
