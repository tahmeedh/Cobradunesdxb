# .env.example — Copy to .env and fill in real values.
# jobapply loads this automatically at startup.

# Required: Anthropic API key for Claude field-filling.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override the Chrome user data directory.
# CHROME_USER_DATA_DIR=/Users/you/Library/Application Support/Google/Chrome

# Optional: Override the Chrome profile sub-directory.
# CHROME_PROFILE_DIRECTORY=Default
